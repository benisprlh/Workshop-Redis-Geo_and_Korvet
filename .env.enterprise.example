# Salin ke .env, lalu ganti endpoint/kredensial dengan nilai dari instruktur.
# Harus unik per peserta jika endpoint Enterprise dipakai bersama.
LAB_ID=lab-01
# Endpoint DATABASE, bukan alamat console/API administrasi. Encode user/password URI.
REDIS_URL=
# Contoh format saja; isi sendiri menggunakan endpoint instruktur:
# REDIS_URL='rediss://USERNAME:PASSWORD@HOST_DATABASE:PORT'
REDIS_CONNECT_TIMEOUT_MS=5000
# Korvet lokal opsional: infra/compose/enterprise.yaml + profil streaming.
# Mode Enterprise menjalankan API/web dan mengecualikan Redis lokal.
# Jika Korvet disiapkan instruktur, isi brokers dan gunakan infra/compose/external.yaml.
KAFKA_BROKERS=korvet:9092
TELEMETRY_TOPIC=
KAFKA_GROUP_ID=
KORVET_NAMESPACE=korvet
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Mode Enterprise menyediakan penghubung TLS untuk Korvet pada jaringan Compose.
# Backend dan Korvet menggunakan endpoint database workshop yang sama.
WEB_PORT=3000
API_PORT=3001
