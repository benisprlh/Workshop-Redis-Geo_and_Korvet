# Default awal Redis lokal. Salin ke .env; latihan terkunci sampai endpoint diganti.
# Harus unik per peserta jika endpoint Enterprise dipakai bersama.
LAB_ID=fieldops-demo
# Endpoint DATABASE, bukan alamat console/API administrasi. Encode user/password URI.
REDIS_URL=redis://redis:6379
# Contoh format saja; isi sendiri menggunakan endpoint instruktur:
# REDIS_URL='rediss://USERNAME:PASSWORD@HOST_DATABASE:PORT'
# Letakkan file instruktur dalam infra/certificates/ (diabaikan Git dan Docker build).
# Kosong jika CA dipercaya sistem; cert/key hanya jika mutual TLS diwajibkan.
REDIS_CA_FILE=
REDIS_CLIENT_CERT_FILE=
REDIS_CLIENT_KEY_FILE=
REDIS_TLS_SERVERNAME=
REDIS_CONNECT_TIMEOUT_MS=5000
# Korvet lokal opsional: infra/compose/enterprise.yaml + profil streaming.
# Redis lokal, API, dan web dimulai. Koneksi lokal tidak membuka latihan.
# Jika Korvet disiapkan instruktur, isi brokers dan gunakan infra/compose/external.yaml.
KAFKA_BROKERS=korvet:9092
TELEMETRY_TOPIC=
KAFKA_GROUP_ID=
KORVET_NAMESPACE=korvet
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Mode Enterprise menyediakan penghubung TLS untuk Korvet pada jaringan Compose.
# API dan penghubung memakai endpoint serta file sertifikat yang sama.
WEB_PORT=8443
API_PORT=3001
