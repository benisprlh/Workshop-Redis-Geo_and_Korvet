# Satu instance lab per peserta. Prefix nama bukan isolasi akses.
LAB_ID=fieldops-demo
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=korvet:9092
# Kosong = diturunkan dari LAB_ID.
TELEMETRY_TOPIC=
KAFKA_GROUP_ID=
KORVET_NAMESPACE=korvet
WEB_PORT=8088
API_PORT=3001
# Opsional untuk endpoint instruktur; rahasia hanya dipakai API.
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
