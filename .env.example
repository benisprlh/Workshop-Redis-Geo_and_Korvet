# Satu instance lab per peserta. Prefix nama bukan isolasi akses.
LAB_ID=fieldops-demo
# Persiapan pertama: endpoint database Redis. Kredensial berada pada URI backend.
REDIS_URL=redis://redis:6379
# rediss:// untuk TLS. Path berikut adalah path DI CONTAINER API.
REDIS_CA_FILE=
REDIS_CLIENT_CERT_FILE=
REDIS_CLIENT_KEY_FILE=
REDIS_TLS_SERVERNAME=
REDIS_CONNECT_TIMEOUT_MS=5000
KAFKA_BROKERS=korvet:9092
# Kosong = diturunkan dari LAB_ID.
TELEMETRY_TOPIC=
KAFKA_GROUP_ID=
KORVET_NAMESPACE=korvet
WEB_PORT=8088
API_PORT=3001
# Opsional untuk endpoint instruktur; rahasia hanya dipakai API.
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
